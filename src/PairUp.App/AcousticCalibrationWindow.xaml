<Window x:Class="PairUp.App.AcousticCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="麦克风自动校准" Language="zh-CN" Width="780" Height="700" MinWidth="650" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" Closing="Window_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="用麦克风对齐音箱" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="把独立麦克风放在平常听音乐的位置，音箱保持原位。主音源与选中音箱先统一使用 20% 音量；只有测试音偏弱时，才依次尝试 30%、40%、50%。50% 仍不可靠时停止，提示你人工检查。" TextWrapping="Wrap" FontSize="14"/>
            <TextBlock Text="测量时暂时静音音乐，并解除所选设备与声屿应用的静音。每台在同一档音量测三次；测输出时，先响音源，再响待测音箱。完成、失败或取消后恢复原音量和静音；若设备断开导致无法恢复，会显示说明。" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,0"/>
            <TextBlock Text="录音只在电脑内存里分析，不保存或上传。耳机需放在麦克风旁才能测量；连接、收音或失真问题不会触发提高音量。" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,16"/>
        </StackPanel>
        <StackPanel Grid.Row="1" x:Name="SelectionPanel">
            <TextBlock Text="收音麦克风" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox x:Name="MicrophoneCombo" DisplayMemberPath="Name" SelectedValuePath="DeviceId" MinHeight="32" AutomationProperties.Name="收音麦克风"/>
            <TextBlock x:Name="SourceText" TextWrapping="Wrap" Margin="0,14,0,8"/>
            <ItemsControl x:Name="TargetsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanChangeSelection}"
                                  Content="{Binding Name}" Padding="0,4" AutomationProperties.Name="待校准音箱"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <CheckBox x:Name="AutoApplyCheck" IsChecked="True" Content="测量可靠时，自动应用延迟" Margin="0,12,0,14"/>
        </StackPanel>
        <ProgressBar Grid.Row="2" x:Name="ProgressBar" Height="6" Visibility="Collapsed" IsIndeterminate="True" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="3" x:Name="StatusText" Text="准备就绪。将从 20% 开始；点击开始后，请保持安静。" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="14"/>
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="ResultsText" TextWrapping="Wrap" FontSize="14" LineHeight="24"/>
        </ScrollViewer>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="StartButton" Content="开始自动校准" Click="Start_Click" Padding="18,9" Margin="0,0,10,0" AutomationProperties.Name="开始自动校准"/>
            <Button x:Name="ApplyButton" Content="应用测量结果" Click="Apply_Click" Padding="16,9" IsEnabled="False" Margin="0,0,10,0"/>
            <Button x:Name="CloseButton" Content="关闭" Click="Close_Click" Padding="16,9"/>
        </StackPanel>
    </Grid>
</Window>
