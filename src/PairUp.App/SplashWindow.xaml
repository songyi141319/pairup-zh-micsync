<Window x:Class="PairUp.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" Width="240" Height="240">
    <Border Background="#162B3C" CornerRadius="28" Opacity="0.98">
        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="LogoMark" Width="88" Height="88" CornerRadius="24" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" ScaleX="0.7" ScaleY="0.7"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect Color="#78B8C5" BlurRadius="24" ShadowDepth="0" Opacity="0.16"/>
                    </Border.Effect>
                    <Image Source="Assets/shengyu.png" Stretch="Uniform"/>
                </Border>

                <TextBlock x:Name="Wordmark" Text="声屿" FontFamily="Bahnschrift SemiBold, Segoe UI Semibold"
                           FontSize="18" Foreground="#f3ede1" HorizontalAlignment="Center"
                           Margin="0,20,0,0" Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="WordmarkOffset" Y="8"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
